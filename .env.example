# Copy to .env; docker compose reads it automatically.

MEATSHELL_TAG=0.8.0

# Container user; must own ./data on the host.
MEATSHELL_UID=1000
MEATSHELL_GID=1000

# Host interface and port for the plaintext MCP listener.
# 127.0.0.1 = only a host-local reverse proxy can reach it (recommended).
# 0.0.0.0   = reachable from the LAN; firewall it.
MEATSHELL_PUBLISH=127.0.0.1
MEATSHELL_PORT=8765

# Base images; point these at a registry mirror if docker.io is blocked.
# BUILDER_BASE=docker.m.daocloud.io/library/rust:1-bookworm
# RUNTIME_BASE=docker.m.daocloud.io/library/debian:bookworm-slim
BUILDER_BASE=rust:1-bookworm
RUNTIME_BASE=debian:bookworm-slim

# rustc codegen jobs during the image build.
CARGO_BUILD_JOBS=4
# crates.io is slow from mainland China; rsproxy resolves in ~0.1s.
CARGO_REGISTRY_MIRROR=sparse+https://rsproxy.cn/index/

TZ=Asia/Shanghai
RUST_LOG=info

# Only for `docker compose --profile proxy up -d` (Caddy + automatic TLS).
MEATSHELL_DOMAIN=shell.example.com
